#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX 5
#define SIZE 100

int raid, disks;
int failed[MAX] = {0};
char data[MAX][SIZE][50];
void writeData(int block, char text[]) {
    int d, b;

    if (raid == 0) {
        d = block % disks;
        b = block / disks;

        if (failed[d])
            printf("Disk failed! Data cannot be written.\n");
        else
            strcpy(data[d][b], text);
    }
 else if (raid == 1) {
        for (d = 0; d < disks; d++)
            if (!failed[d])
                strcpy(data[d][block], text);

        printf("Data written using mirroring.\n");
    }

    else if (raid == 5) {
        d = block % (disks - 1);
        b = block / (disks - 1);

        if (!failed[d])
            strcpy(data[d][b], text);

        printf("Data written using RAID 5.\n");
    }
}

